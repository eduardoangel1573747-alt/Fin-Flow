  "cards": [
    {
      "dot": "emerald",
      "title": "Flujo Operativo Fin Flow",
      "items": [
        "El usuario inicia sesión o se registra mediante Firebase Authentication",
        "onAuthStateChanged recupera el estado de Firestore (ingresos, transacciones, carteras y metas)",
        "El Dashboard sincroniza cálculos en tiempo real y persiste cambios automáticamente"
      ]
    },
    {
      "dot": "cyan",
      "title": "Gobernanza y Cierre Mensual",
      "items": [
        "El modal de Cierre de Mes congela el periodo y genera un snapshot en globalHistory",
        "Las vistas históricas permiten auditar y filtrar transacciones previas sin perder datos"
      ]
    },
    {
      "dot": "violet",
      "title": "Sincronización y Resiliencia",
      "items": [
        "Persistencia híbrida con Firebase Firestore como fuente única de verdad en la nube",
        "LocalStorage almacena configuraciones de usuario como idioma (ES/EN) y símbolo de moneda"
      ]
    }
